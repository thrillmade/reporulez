{
  "name": "fixture-deletion-and-pull-request-no-bypass",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["refs/heads/dev", "refs/heads/main"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "pull_request", "parameters": { "required_approving_review_count": 0 } }
  ]
}
