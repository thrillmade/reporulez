{
  "name": "CI must pass",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/dev"
      ],
      "exclude": []
    },
    "repository_name": {
      "include": [
        "~ALL"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "ci"
          }
        ]
      }
    }
  ]
}
